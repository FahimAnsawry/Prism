// Prisma schema for Prism. Docs: https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (CLI, DIRECT_URL) and in the
// PrismaClient adapter (runtime, pooled DATABASE_URL), not in this file.

generator client {
  provider            = "prisma-client"
  output              = "../src/db/generated"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (Better Auth core tables) ─────────────────────────────────────────
// Field names must match Better Auth's schema; ids are generated by Better Auth.

// One row per person, keyed by email. Every sign-in method for the same email
// links to this row through Account (see account linking in src/auth.ts).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  // Photo from the sign-in provider; Better Auth refreshes it when a new method is linked.
  image         String?
  // S3 object key of a photo the user uploaded. When set, the app shows it instead
  // of `image`, so provider syncs never replace an uploaded photo.
  imageKey      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  projects     Project[]
  boards       Board[]
  apiTokens    ApiToken[]
  editRequests EditRequest[]

  // OAuth for MCP clients (Better Auth mcp plugin)
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@map("user")
}

// One row per sign-in method: providerId is "credential" (email/password),
// "google" or "github"; accountId is the provider's id for the user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Password hash; only set on the "credential" account
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

// Short-lived tokens (email verification, password reset, OAuth state)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Workspace: projects, boards and board elements ────────────────────────

enum ElementType {
  text
  sticky
  list
  rect
  ellipse
  diamond
  line
  arrow
  freehand
  emoji
  image
  svg
  chart
  frame
  icon
  mindnode
}

enum StrokeStyle {
  solid
  dashed
  dotted
}

// Who made the last change to an element.
enum Author {
  user
  ai_agent
}

// A folder of boards on the dashboard.
model Project {
  id          String    @id @default(uuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String    @default("Untitled project")
  description String?
  // Last change to the project or any of its boards ("edited 2h ago").
  editedAt    DateTime  @default(now())
  // Set = in the trash; hides the project and its boards.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boards Board[]

  @@index([ownerId, editedAt(sort: Desc)])
  @@map("project")
}

// One whiteboard. projectId = null means a standalone board.
// ownerId must equal project.ownerId when projectId is set (checked in app code).
model Board {
  id           String    @id @default(uuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String    @default("Untitled board")
  description  String?
  // S3 object key of the PNG preview shown on dashboard cards.
  thumbnailKey String?
  // Swatches added with the color picker (#rrggbb) and Google Fonts family names, newest first.
  customColors String[]  @default([])
  customFonts  String[]  @default([])
  // Last content change (rename or any element change).
  editedAt     DateTime  @default(now())
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  elements     Element[]
  editRequests EditRequest[]

  @@index([ownerId, editedAt(sort: Desc)])
  @@index([projectId, editedAt(sort: Desc)])
  @@map("board")
}

// One drawn item (tools.md §7). Shared fields are columns; type-specific
// data (text, points, bindings, chart data, S3 key, ...) lives in props.
model Element {
  boardId     String
  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // crypto.randomUUID(), made by the client or by the MCP server.
  id          String
  type        ElementType
  x           Float
  y           Float
  width       Float
  height      Float
  rotation    Float       @default(0)
  // Float so an element can be placed between two layers without renumbering.
  z           Float
  stroke      String
  fill        String?
  strokeWidth Float
  strokeStyle StrokeStyle @default(solid)
  sketch      Boolean     @default(false)
  opacity     Float       @default(1)
  groupId     String?
  locked      Boolean     @default(false)
  role        String?
  props       Json        @default("{}")
  updatedBy   Author
  // Sync conflict check: the higher version wins.
  version     Int         @default(1)
  // Tombstone, so a stale update can't bring a deleted element back.
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@id([boardId, id])
  @@map("element")
}

// ── AI editors (MCP bridge) ────────────────────────────────────────────────

// A personal access token an AI editor's MCP bridge signs in with. It acts as its user,
// on that user's boards only. The token itself is shown once; only its SHA-256 is kept.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // The token's first characters, to tell tokens apart in the list.
  start      String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_token")
}

enum EditStatus {
  pending
  working
  done
  failed
}

// An "Ask AI" request typed in the browser for the selected elements, picked up by an AI editor.
model EditRequest {
  id         String     @id @default(uuid())
  boardId    String
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  elementIds String[]
  prompt     String
  status     EditStatus @default(pending)
  // The AI editor's short reply, shown in the browser.
  note       String?
  // When an AI editor took it; a "working" request that sits too long is handed out again.
  claimedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, status, createdAt])
  @@index([boardId, createdAt(sort: Desc)])
  @@map("edit_request")
}

// ── OAuth for MCP clients ──────────────────────────────────────────────────
// Tables of Better Auth's jwt, mcp (OAuth provider) and cimd plugins (src/auth.ts). Field names
// must match Better Auth's schema; ids are generated by Better Auth. Better Auth's adapter stores
// "json" fields as text (String), and passes null for an unset optional list, where null and []
// mean different things (e.g. any scope vs none), so those lists are nullable Json columns
// (src/db/auth-prisma.ts turns null into a database NULL).

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         String?

  oauthClientResources OauthClientResource[]
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]
  oauthConsents        OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      String?

  oauthClientResources OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   String?
  createdAt  DateTime?

  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String[]

  oauthAccessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            String?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}
