# Copy to apps/server/.env and fill in. Never commit the real .env.

# ── Server ────────────────────────────────────────────────────────────────
# Port the Express + Socket.IO server listens on
PORT=4000
# Public base URL of this server (used for absolute links and OAuth redirects)
SERVER_URL=http://localhost:4000
# Origin of the React client; allowed by CORS and Socket.IO, and trusted by Better Auth
CLIENT_URL=http://localhost:5173

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────
# POOLED connection string (host contains "-pooler"); used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT connection string (same host without "-pooler"); used by the Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Better Auth ───────────────────────────────────────────────────────────
# Secret for signing sessions/tokens; at least 32 random chars (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Base URL where Better Auth is served (this server); OAuth callbacks go to <URL>/api/auth/callback/<provider>
BETTER_AUTH_URL=http://localhost:4000

# ── OAuth: Google (Google Cloud Console → APIs & Services → Credentials) ──
# OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
# OAuth 2.0 Client secret
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub (GitHub → Settings → Developer settings → OAuth Apps) ───
# OAuth App Client ID
GITHUB_CLIENT_ID=
# OAuth App Client secret
GITHUB_CLIENT_SECRET=

# ── Object storage for board images (any S3-compatible provider) ──────────
# Default: Neon Object Storage (beta, AWS us-east-2 projects only). Cloudflare R2 also works.
# S3 endpoint. Neon: the branch's storage endpoint (each DB branch has its own), e.g.
#   https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech   (R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Region. Neon: us-east-2 (R2: auto)
S3_REGION=us-east-2
# Bucket name in the URL path instead of the hostname. Neon: true, required (R2: false)
S3_FORCE_PATH_STYLE=true
# Access key ID. Neon: the branch credential's token_id, nak_live_... (R2: API token Access Key ID)
S3_ACCESS_KEY_ID=
# Secret access key. Neon: the credential's s3_secret_access_key, nsk_live_... (R2: API token Secret Access Key)
S3_SECRET_ACCESS_KEY=
# Bucket that stores uploaded board images
S3_BUCKET=prism-uploads
