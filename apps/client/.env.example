# Copy to apps/client/.env and fill in. Never commit the real .env.
# Only variables prefixed with VITE_ are exposed to the browser, and they are baked
# into the static build, so NEVER put secrets here.

# Base URL of the API server (REST, Socket.IO and Better Auth at /api/auth)
VITE_SERVER_URL=http://localhost:4000
# Public URL of this client app (used to build shareable board/room links)
VITE_CLIENT_URL=http://localhost:5173

# Public demo account the login form fills in (must match the server's DEMO_EMAIL and
# DEMO_PASSWORD). It is public on purpose: these values ship in the build. Leave empty for none.
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=prism-demo-2026
